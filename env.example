# Copy to .env in the project root (edge_bot loads it on startup) or export in your shell.
# Never commit real keys.

KALSHI_ACCESS_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Production default; demo: https://demo-api.kalshi.co
KALSHI_HOST=https://api.elections.kalshi.com

# Single market, or use KALSHI_MARKET_TICKERS / KALSHI_AUTO_MARKETS instead
KALSHI_MARKET_TICKER=
# Comma-separated, e.g. TICK1,TICK2
# KALSHI_MARKET_TICKERS=
# Default (omit or 15m): KXBTC15M only. Use hourly, both, or btc for KXBTC hourly too.
# KALSHI_AUTO_MARKETS=15m
# KALSHI_AUTO_MARKETS=both

# Per-ticker JSON state files
# BOT_STATE_DIR=data/bot_state

# Optional second model for KXBTC (hourly range) if you train one
# FAIR_YES_MODEL_HOURLY=data/models/fair_yes_hourly.json

# Browser dashboard (trade_dashboard.py): default http://127.0.0.1:8765/
# PORT=8765
# HOST=127.0.0.1

# Fair P(YES): either set FAIR_YES manually, or train a model (below) and use FAIR_YES_MODEL / default JSON.
# FAIR_YES=0.55
FAIR_YES_MODEL=data/models/fair_yes_logistic.json

# Optional: btc-trend model (JSON logistic, Kalshi+HGB manifest, or .joblib); see scripts/train_btc_trend_model.py,
# scripts/train_btc_trend_kalshi.py (settled KXBTC15M labels; default --days=120), scripts/tune_btc_trend_thresholds.py,
# scripts/walk_forward_eval.py, scripts/ablation_entry_filters.py
# Retrain (default: HGB + last-14d val split + Platt). Disable Platt: add --no-platt. Logistic: --model-kind logistic
#   python scripts/train_btc_trend_kalshi.py --days 120 --out data/models/btc_trend_logistic.json --calibration-report data/models/btc_trend_val_calibration.json
# BTC_TREND_MODEL=data/models/btc_trend_logistic.json
# Daily BTC headline sentiment tilts fair P(YES) for edge (0=off). Optional NEWSAPI_KEY for backtest history.
# BTC_NEWS_TILT=0.06
# NEWSAPI_KEY=
# Extra EV cushion after spread-adjusted threshold (0=off; default 0.02 if unset in edge_bot / backtest CLI)
# MIN_EV_SURPLUS_DOLLARS=0.02
# Min fair P(side) for entries: YES needs fair_yes>=this, NO needs fair_yes<=1-this (0=off; default 0.62 if unset)
# MIN_DIRECTION_CONFIDENCE=0.62
# Stress slippage: add to executable ask(s) for EV + order prices
# ASK_SLIP_DOLLARS=0

# Contracts per IOC entry (string for fractional e.g. 1.00)
CONTRACTS=1

# Minimum expected $ edge per contract after ask + estimated taker fee (base; see EDGE_SPREAD_MULT)
MIN_EDGE_DOLLARS=0.04
# Skip if that side's bid/ask spread is wider (0 = disable)
MAX_BOOK_SPREAD=0.12
# Extra EV cushion: EDGE_SPREAD_MULT * spread on the leg you would buy
EDGE_SPREAD_MULT=0.30

# Stop: (entry_ask - current_bid_on_that_side) / entry_ask >= this => reduce-only IOC exit
STOP_LOSS_PCT=0.20
# Exit edge_bot if equity drops this fraction below baseline (0=off). Live: first /portfolio/balance; paper: vs starting_capital
# MAX_CAPITAL_LOSS_PCT=0.30

# Quadratic taker coefficient (verify against Kalshi fee schedule for your products)
FEE_COEFFICIENT=0.07

# Optional: persisted bot state (entry for stop-loss)
BOT_STATE_FILE=data/edge_bot_state.json
